{
  "headers": [
    {
      "source": "/menu.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/menus/:file",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ]
}
